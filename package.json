{
  "name": "resapi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "tests/fixtures",
    "tests/compile-fail"
  ],
  "scripts": {
    "build": "rescript",
    "watch": "rescript watch",
    "clean": "rescript clean",
    "format": "rescript format",
    "test": "rescript && node --test",
    "test:worker": "scripts/test-worker.sh",
    "dev": "npm run build && npm run dev -w examples/cloudflare",
    "format:check": "rescript format --check",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:clean-build": "scripts/check-clean-build.sh",
    "dev:express": "npm run build && npm start -w examples/express",
    "check:packages": "scripts/check-packages.sh",
    "release:check": "npm run format:check && npm test && npm run check:isolation && npm run test:worker && npm run check:packages"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "rescript": "12.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sury-ppx@11.0.0": true,
    "workerd@1.20261006.1": true
  }
}
